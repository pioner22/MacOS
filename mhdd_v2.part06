esac

say 'WARNING: THE NEXT STAGE DESTROYS ALL DATA ON THE INTERNAL APPLE SSD.'
say "TARGET CONFIRMED: $TARGET  $MODEL  $BYTES bytes"
say 'The script refuses non-internal/non-Apple/non-SSD targets and will not select external disks.'
printf 'Type ERASE to begin full destructive LBA diagnostics: '
ANSWER=''
if [ -r /dev/tty ]; then
  IFS= read ANSWER </dev/tty
else
  IFS= read ANSWER
fi
[ "$ANSWER" = ERASE ] || fail 'destructive test cancelled'

# Identity and root-device checks repeated immediately before destructive I/O.
ORIG_TARGET=$TARGET; ORIG_BYTES=$BYTES; ORIG_MODEL=$MODEL
find_target
[ "$TARGET" = "$ORIG_TARGET" ] || fail 'target changed after confirmation'
[ "$BYTES" = "$ORIG_BYTES" ] || fail 'target size changed after confirmation'
[ "$MODEL" = "$ORIG_MODEL" ] || fail 'target model changed after confirmation'
ROOTDEV=$(df / 2>/dev/null | awk 'NR==2{print $1}')
case "$ROOTDEV" in *"$DISK"*) fail "refusing: Recovery root appears on target ($ROOTDEV)";; esac

if command -v pmset >/dev/null 2>&1; then pmset -g batt 2>/dev/null | tee -a "$LOG" || true; fi
say 'Keep AC power connected. Do not interrupt unless the Mac hangs or persistent I/O errors appear.'

diskutil unmountDisk force "$TARGET" 2>&1 | tee -a "$LOG"; URC=${PIPESTATUS[0]:-1}
[ "$URC" -eq 0 ] || fail "cannot unmount internal disk rc=$URC"

raw_sequential_scan 'PREWRITE_RAW_SCAN'
PRE_SCAN_IOERR=$SCAN_IOERR
random_4k_scan 'PREWRITE_RANDOM_SCAN'
PRE_RND_IOERR=$RND_IOERR
if [ "$PRE_SCAN_IOERR" -ne 0 ] || [ "$PRE_RND_IOERR" -ne 0 ]; then
  err "PREWRITE_ERRORS sequential=$PRE_SCAN_IOERR random=$PRE_RND_IOERR"
  err 'Continuing because a destructive diagnostic was explicitly requested; errors remain evidence of storage-path instability.'
fi

write_pattern_pass A
A_WRITE_IOERR=$WRITE_IOERR
verify_pattern_pass A INPROGRESS_A "$BOOT_NOW"
if [ "$A_WRITE_IOERR" -ne 0 ] || [ "$VERIFY_IOERR" -ne 0 ] || [ "$VERIFY_HASHERR" -ne 0 ]; then
  fail "PATTERN_A_FAILED write_io=$A_WRITE_IOERR verify_io=$VERIFY_IOERR hash=$VERIFY_HASHERR"
fi
commit_complete_marker A || fail 'cannot commit/verify COMPLETE_A marker'
say 'PATTERN_A_WRITE_VERIFY=PASS'
say 'STAGE=COMPLETE_A'
persist_log_if_possible COMPLETE_A
say 'REBOOT_REQUIRED: restart into Internet Recovery, then run the SAME st.sh command again.'
exit 0
